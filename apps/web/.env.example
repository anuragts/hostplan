# Copy to .env.local for a local run against real storage, or paste these into
# Vercel's environment variables for a deployment.
#
# None of these are needed to run hostplan locally: with all three unset the
# viewer reads ~/.hostplan off disk and skips auth entirely, which is what
# `hsp serve` on localhost:7433 does today.

# Owner secret. Setting this is what turns auth on: it gates every write, the
# index pages, and browsing private plans. The CLI sends it as a bearer token,
# the browser exchanges it for a session cookie at /login.
#   openssl rand -hex 32
HSP_TOKEN=

# Supabase project URL. Setting this is what switches the store from the local
# filesystem to the bucket — so set it and HSP_TOKEN together, or a deployment
# would serve the bucket with no auth in front of it.
SUPABASE_URL=https://your-project-id.supabase.co

# Secret key from Settings -> API -> "Secret keys" (starts with sb_secret_).
# NOT the publishable key: that one has no storage access.
# Older projects issue a `service_role` JWT instead, under the legacy tab —
# SUPABASE_SERVICE_ROLE_KEY is still read as a fallback if that is all you have.
#
# This key bypasses row-level security. Server-side only, never NEXT_PUBLIC_,
# and never committed.
SUPABASE_SECRET_KEY=
