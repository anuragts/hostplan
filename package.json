{
	"name": "hostplan",
	"version": "0.1.0",
	"description": "An open-source CLI and web viewer for storing, sharing, resuming, and handing off coding-agent plans.",
	"keywords": [
		"ai-agents",
		"coding-agents",
		"codex",
		"claude-code",
		"cursor",
		"developer-tools",
		"planning"
	],
	"license": "MIT",
	"author": "anuragts",
	"homepage": "https://plans.host-plan.com",
	"bugs": {
		"url": "https://github.com/anuragts/hostplan/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anuragts/hostplan.git"
	},
	"type": "module",
	"packageManager": "bun@1.3.12",
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=20.9.0"
	},
	"files": [
		"CHANGELOG.md",
		"dist",
		"apps/web/app",
		"apps/web/components",
		"apps/web/lib",
		"apps/web/public",
		"apps/web/package.json",
		"apps/web/next.config.ts",
		"apps/web/postcss.config.mjs",
		"apps/web/tsconfig.json",
		"packages/core/src",
		"tsconfig.base.json"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"bin": {
		"hsp": "dist/hsp.js"
	},
	"scripts": {
		"build": "bun run --cwd apps/web build",
		"build:cli": "bun build apps/cli/bin/hsp.ts --target=bun --outfile=dist/hsp.js --minify",
		"dev": "bun run --cwd apps/web dev",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepack": "bun run build:cli",
		"prepublishOnly": "bun run release:check",
		"release:check": "bun test && bun run typecheck && bun run build && bun run build:cli && npm pack --dry-run --ignore-scripts",
		"typecheck": "bun run --cwd packages/core typecheck && bun run --cwd apps/cli typecheck && bun run --cwd apps/web typecheck",
		"test": "bun test"
	},
	"dependencies": {
		"@shikijs/rehype": "^3.0.0",
		"@supabase/ssr": "^0.12.3",
		"@supabase/supabase-js": "^2.110.8",
		"@tailwindcss/postcss": "^4.0.0",
		"@tailwindcss/typography": "^0.5.16",
		"@types/bun": "^1.3.14",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.27.0",
		"next": "^16.0.0",
		"posthog-js": "^1.407.2",
		"radix-ui": "^1.6.7",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.0",
		"remark-gfm": "^4.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.0.0",
		"shadcn": "^4.15.0",
		"shiki": "^3.0.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.0",
		"unified": "^11.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"commander": "^15.0.0"
	}
}
