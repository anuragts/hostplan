# Copy to .env.local for a local run against real storage, or paste these into
# Vercel's environment variables for a deployment.
#
# None of these are needed to run hostplan locally: with all three unset the
# viewer reads ~/.hostplan off disk and skips auth entirely, which is what
# `hsp serve` on localhost:7433 does today.

# Supabase project URL. Setting this switches the store from the local
# filesystem to the bucket.
SUPABASE_URL=https://your-project-id.supabase.co

# Turns multi-user accounts on. Set this ONLY after running
# supabase/migrations/0001_multi_user.sql — the app will query tables that the
# migration creates, and without them every request fails.
HOSTPLAN_ACCOUNTS=

# Publishable key from Settings -> API -> "Publishable key" (sb_publishable_...).
# Safe in a browser: it carries no privileges of its own, so every query made
# with it is subject to row-level security. Setting it is what turns accounts on.
SUPABASE_PUBLISHABLE_KEY=

# Secret key from Settings -> API -> "Secret keys" (starts with sb_secret_).
# NOT the publishable key: that one has no storage access.
# Older projects issue a `service_role` JWT instead, under the legacy tab —
# SUPABASE_SERVICE_ROLE_KEY is still read as a fallback if that is all you have.
#
# This key bypasses row-level security. Server-side only, never NEXT_PUBLIC_,
# and never committed.
SUPABASE_SECRET_KEY=

# PostHog project API key (phc_...). Optional: analytics stay off when unset,
# so local `hsp serve` runs are never tracked. Safe in a browser.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sea public ingestion settings. Optional locally; production uses one isolated
# project key and the shared Cloudflare collector.
NEXT_PUBLIC_SEA_PROJECT_KEY=
NEXT_PUBLIC_SEA_COLLECTOR_URL=https://sea-worker.anuragsharma011011.workers.dev/v1/collect
